# Provider do agente humanizador: "google" (default, Gemini) ou "anthropic" (Claude)
# LLM_PROVIDER=google

# Google AI Studio API key para o Gemini 2.5 Flash
# Gere em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional: modelo a ser usado (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Usado apenas se LLM_PROVIDER=anthropic
# Gere em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Opcional: modelo Claude a ser usado (default: claude-sonnet-4-5)
# ANTHROPIC_MODEL=claude-sonnet-4-5
